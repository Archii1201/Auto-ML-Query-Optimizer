# =============================================================================
# Phase 4E — environment template. Copy to `.env` and edit; docker-compose
# reads it automatically. NEVER commit a real .env (it's in .gitignore).
# =============================================================================

# ----- PostgreSQL -----
PGDATABASE=automl_qo
PGUSER=postgres
PGPASSWORD=postgres          # CHANGE ME in any non-local deployment
PG_PORT=5432

# ----- ML service (Phase 4A resilience knobs) -----
ML_LOG_LEVEL=INFO
ML_POOL_MIN=2
ML_POOL_MAX=10
ML_POOL_ACQUIRE_TIMEOUT_S=2.0
ML_REQUEST_BUDGET_MS=8000
ML_CB_FAILS=5
ML_CB_WINDOW_S=30
ML_CB_RESET_S=60
ML_SERVICE_SEARCH_PATH=tpch, public

# ----- Cache (Phase 4B) -----
CACHE_BACKEND=redis          # local | redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_S=3600

# ----- Model registry (Phase 4B) -----
# MODEL_REGISTRY_DIR=/app/models/registry

# ----- Model hot-swap (Phase 5C) -----
# Shared secret for POST /admin/reload-models. The endpoint refuses all
# callers until this is set to a non-empty value. CHANGE ME.
ML_ADMIN_TOKEN=changeme

# ----- AutoML retrain worker (Phase 5E) -----
AUTOML_PROFILE=fast              # fast (no Optuna) | full (Optuna)
AUTOML_POLL_INTERVAL_S=300       # how often the worker evaluates triggers
AUTOML_REGIME=plan_time
# Reload EVERY replica after a promotion (comma-separated base URLs):
AUTOML_RELOAD_URL=http://ml-service-1:8000,http://ml-service-2:8000
# Scrape one replica's calibration gauge for the drift trigger:
AUTOML_METRICS_URL=http://ml-service-1:8000/metrics
# Trigger tuning (see services/automl_service/triggers.py for defaults):
# AUTOML_MIN_NEW_ROWS=200
# AUTOML_COOLDOWN_MINUTES=360
# AUTOML_MAX_INTERVAL_MINUTES=1440

# ----- Feedback bus (Phase 4C) -----
FEEDBACK_BUS=file            # file | kafka
KAFKA_BOOTSTRAP=kafka:9092
FEEDBACK_TOPIC=query.feedback.v1
FEEDBACK_GROUP=feedback-writer

# ----- Observability (Phase 4D) -----
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false           # set true to export traces to the collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_PASSWORD=admin

# ----- Ports -----
HTTP_PORT=80
HTTPS_PORT=443
KAFKA_UI_PORT=8080
PROM_PORT=9090
GRAFANA_PORT=3000
LOCUST_PORT=8089

# ----- Load test (Phase 4F) -----
LOAD_TARGET=http://nginx:80
