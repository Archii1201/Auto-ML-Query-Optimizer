{
  "uid": "retrain-promotions",
  "title": "AutoML — Retrain & Post-Promotion Health",
  "tags": ["automl-qo", "phase5"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prediction calibration — pred/actual ratio (watchdog band 0.5–2.0)",
      "description": "The signal the 5F watchdog rolls back on. p95 leaving [0.5, 2.0] after a promotion triggers auto-rollback.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(pred_actual_ratio_bucket[15m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(pred_actual_ratio_bucket[15m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 0.5 },
            { "color": "red", "value": 2.0 }
          ]}
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Live error rate (execution failures / executions)",
      "description": "Watchdog rolls back if this exceeds the absolute cap or spikes over the pre-promote baseline.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(execution_failures_total[15m])) / clamp_min(sum(rate(executions_total[15m])), 1)", "legendFormat": "error rate" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Inference latency p95 (ms)",
      "description": "Watchdog rolls back on a p95 regression beyond the baseline tolerance.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(inference_latency_ms_bucket[15m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Plan-pick accuracy (oracle hits / picks)",
      "description": "Post-promotion quality trend — should hold or improve after a promotion.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(plan_pick_oracle_hits_total[1h])) / clamp_min(sum(rate(plan_picks_total[1h])), 1)", "legendFormat": "accuracy" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PG-default fallbacks (circuit breaker / errors)",
      "description": "A newly promoted model that fails at serving time shows up as a fallback spike.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(plan_pick_fallback_total[15m]))", "legendFormat": "fallbacks/s" }
      ]
    }
  ]
}
