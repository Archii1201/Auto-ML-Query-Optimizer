{
  "uid": "plan-pick-quality",
  "title": "ML Service — Plan-pick Quality",
  "tags": ["automl-qo", "phase4d"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Plan-pick accuracy (oracle hits / picks)",
      "description": "Only populated when /run-and-learn runs with oracle=true.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(plan_pick_oracle_hits_total[1h])) / clamp_min(sum(rate(plan_picks_total[1h])), 1)", "legendFormat": "accuracy" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Regret (ms) vs oracle",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(regret_ms_bucket[1h])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(regret_ms_bucket[1h])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Predicted / actual ratio (1.0 = perfect)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(pred_actual_ratio_bucket[1h])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(pred_actual_ratio_bucket[1h])) by (le))", "legendFormat": "p95" }
      ]
    }
  ]
}
